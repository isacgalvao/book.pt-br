msgid "<Listing number=\"8-22\" caption=\"Showing that keys and values are owned by the hash map once they’re inserted\">\n"
msgstr "<Listing number=\"8-22\" caption=\"Mostrando que as chaves e os valores pertencem ao hash map depois que são inseridos\">\n"

