msgid "<Listing number=\"18-7\" file-name=\"src/lib.rs\" caption=\"A `Button` struct that implements the `Draw` trait\">\n"
msgstr "<Listing number=\"18-7\" file-name=\"src/lib.rs\" caption=\"Um struct `Button` que implementa o trait `Draw`\">\n"

