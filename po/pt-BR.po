msgid "<Listing number=\"11-8\" file-name=\"src/lib.rs\" caption=\"Testing that a condition will cause a `panic!`\">\n"
msgstr "<Listing number=\"11-8\" file-name=\"src/lib.rs\" caption=\"Testando se uma condição causa um `panic!`\">\n"

