"* ch02-00-guessing-game-tutorial.md\n"
"* ch14-03-cargo-workspaces.md\n"
"-->\n"
msgstr ""

#: src/ch07-04-bringing-paths-into-scope-with-the-use-keyword.md
msgid "<Listing file-name=\"Cargo.toml\">\n"
msgstr ""

