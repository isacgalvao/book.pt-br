msgid "\"'a' started.\""
msgstr ""

#: src/ch17-03-more-futures.md
msgid "\"a\""
msgstr ""

#: src/ch17-03-more-futures.md
msgid "\"'a' finished.\""
msgstr ""

#: src/ch17-03-more-futures.md
msgid "\"'b' started.\""
msgstr ""

#: src/ch17-03-more-futures.md
msgid "\"b\""
msgstr ""

#: src/ch17-03-more-futures.md
msgid "\"'b' finished.\""
msgstr ""

#: src/ch17-03-more-futures.md
msgid "Each future hands control back to the runtime only _after_ carrying out a bunch of slow operations. If you run this code, you will see this output:"
msgstr ""

