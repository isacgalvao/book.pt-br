msgid "<Listing number=\"18-10\" file-name=\"src/main.rs\" caption=\"Attempting to use a type that doesn’t implement the trait object’s trait\">\n"
msgstr "<Listing number=\"18-10\" file-name=\"src/main.rs\" caption=\"Tentativa de usar um tipo que não implementa o trait do objeto de trait\">\n"

