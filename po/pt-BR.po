msgid "This code does not compile!"
msgstr "Este código não compila!"

#: src/ch00-00-introduction.md
msgid "<img src=\"img/ferris/panics.svg\" class=\"ferris-explain\" alt=\"Ferris throwing up their hands\"/>"
msgstr "<img src=\"img/ferris/panics.svg\" class=\"ferris-explain\" alt=\"Ferris jogando as mãos para cima\"/>"

#: src/ch00-00-introduction.md
