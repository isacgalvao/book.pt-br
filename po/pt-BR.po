msgid "<Listing number=\"13-5\" file-name=\"src/main.rs\" caption=\"Defining and calling a closure that captures a mutable reference\">\n"
msgstr "<Listing number=\"13-5\" file-name=\"src/main.rs\" caption=\"Definindo e chamando um closure que captura uma referência mutável\">\n"

#: src/ch13-01-closures.md
